generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String          @id @default(cuid())
  name          String?
  email         String?         @unique
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
  preferences   UserPreferences?
  recentTools   RecentTool[]
  savedData     SavedToolData[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model UserPreferences {
  userId    String   @id
  theme     String   @default("light")
  locale    String   @default("kh")
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RecentTool {
  userId       String
  toolId       String
  lastOpenedAt DateTime @default(now())
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, toolId])
  @@index([userId, lastOpenedAt])
}

model SavedToolData {
  id        String   @id @default(cuid())
  userId    String
  toolId    String
  title     String   @db.VarChar(100)
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, toolId, updatedAt])
}

enum DocumentConversionStatus {
  WAITING
  PROCESSING
  FINISHED
  ERROR
}

model DocumentConversionJob {
  id              String                    @id @default(cuid())
  accessTokenHash String                    @unique @db.Char(64)
  providerJobId   String                    @unique
  mode            String                    @db.VarChar(20)
  filename        String                    @db.VarChar(255)
  outputFilename  String?                   @db.VarChar(255)
  status          DocumentConversionStatus  @default(WAITING)
  expiresAt       DateTime
  createdAt       DateTime                  @default(now())
  updatedAt       DateTime                  @updatedAt

  @@index([expiresAt])
}

model DocumentConversionRateLimit {
  ipHash          String   @id @db.Char(64)
  windowStartedAt DateTime
  attempts        Int      @default(0)

  @@index([windowStartedAt])
}
